# Variables d'environnement pour PRODUCTION AWS
# Copiez ce fichier vers .env et remplissez vos valeurs

# =============================================================================
# PINECONE - Base de données vectorielle
# =============================================================================
PINECONE_API_KEY=votre_cle_pinecone_ici
INDEX_NAME=benin-heritage

# =============================================================================
# GOOGLE GEMINI - Modèle de langage
# =============================================================================
GEMINI_API_KEY=votre_cle_gemini_ici

# =============================================================================
# CONFIGURATION SERVEUR
# =============================================================================
# Remplacez par votre IP Elastic AWS ou nom de domaine
BASE_URL=http://VOTRE_ELASTIC_IP
# Ou avec domaine:
# BASE_URL=https://api.votre-domaine.com

# Port (ne pas changer sauf besoin spécifique)
PORT=8000

# =============================================================================
# CHEMINS (ne pas modifier)
# =============================================================================
BASE_PATH=Donnees_soutenance

# =============================================================================
# CONFIGURATION PRODUCTION (Optionnel)
# =============================================================================
# Nombre de workers Gunicorn (2 x nombre de CPU + 1)
# Pour t3.small (2 vCPU): 2-4 workers
WORKERS=2

# Timeout pour requêtes longues (en secondes)
TIMEOUT=120

# Niveau de log (debug, info, warning, error)
LOG_LEVEL=info

# =============================================================================
# NOTES
# =============================================================================
# 1. NE JAMAIS commiter ce fichier avec vos vraies clés
# 2. Gardez ce fichier en sécurité sur votre serveur EC2
# 3. Utilisez AWS Secrets Manager pour plus de sécurité (optionnel)
# 4. Vérifiez que .env est dans .gitignore
